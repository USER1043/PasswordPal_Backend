# Copy to .env and fill in. Never commit .env.

# --- Required ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret (service_role) key, NOT the publishable/anon key.
SUPABASE_SECRET_KEY=
# Signs session tokens. Generate: openssl rand -hex 32
JWT_SECRET=
# Encrypts TOTP secrets at rest. Required in production. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Optional ---
PORT=3000
NODE_ENV=development
# Extra allowed CORS origin (the Tauri origins are always allowed)
FRONTEND_URL=http://localhost:5173
# Number of reverse proxies in front of the app (0 for local development)
TRUST_PROXY_HOPS=0
